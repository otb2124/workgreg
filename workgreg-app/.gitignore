# Node dependencies & Angular build outputs
node_modules/
dist/
.angular/
tmp/
out-tsc/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri build artifacts
src-tauri/target/

# Generated PyInstaller sidecar binary inside Tauri
# Keeps the folder tracked via .gitkeep while ignoring .exe binaries
src-tauri/bin/*
!src-tauri/bin/.gitkeep

# IDE / OS junk
.DS_Store
Thumbs.db
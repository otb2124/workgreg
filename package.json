{
  "name": "workgreg-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install": "npm --prefix workgreg-app install",

    "start:desktop": "npm --prefix workgreg-app run tauri dev",
    "start:web": "npm --prefix workgreg-app run start",
    "start": "npm run start:frontend:web",

    "dev:web": "npm run start:frontend:web",
    "dev:desktop": "npm run start:frontend:desktop",
    "dev": "npm run dev:web",

    "build:web": "npm --prefix workgreg-app run build",
    "build:desktop": "npm --prefix workgreg-app run tauri build",
    "build": "npm run build:web"
  }
}